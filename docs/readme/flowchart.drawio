<mxfile host="app.diagrams.net">
  <diagram id="p1" name="Page-1">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" page="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lane" value="Backend" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#fafafa;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="360" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="svc" value="API&lt;br&gt;&lt;b&gt;Service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane">
          <mxGeometry x="30" y="50" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="Database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane">
          <mxGeometry x="230" y="40" width="80" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="User" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="dec" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="260" y="30" width="100" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Dashed edges are async" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="140" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="request" style="endArrow=classic;html=1;" edge="1" parent="1" source="user" target="dec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="dec" target="svc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;startArrow=oval;startFill=0;" edge="1" parent="1" source="svc" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="no" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="dec" target="db">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="120"/>
              <mxPoint x="450" y="250"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="Second">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a" value="Only on page 2" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="140" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
