<mxfile host="app.diagrams.net">
  <diagram id="flow" name="Request handling">
    <mxGraphModel dx="800" dy="400" grid="1" gridSize="10" page="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="client" value="Client" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="0" y="50" width="90" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="valid" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="160" y="25" width="110" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="50" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="Database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="35" width="90" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="reject" value="Reject" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="160" y="180" width="110" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="request" style="html=1;endArrow=classic;fontSize=12;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="client" target="valid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="yes" style="html=1;endArrow=classic;fontSize=12;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="valid" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="query" style="html=1;endArrow=classic;fontSize=12;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="no" style="html=1;endArrow=classic;fontSize=12;align=left;spacingLeft=4;labelBackgroundColor=none;strokeColor=#b85450;" edge="1" parent="1" source="valid" target="reject">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;dashed=1;fontSize=12;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="reject" target="client">
          <mxGeometry x="-0.5" relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
